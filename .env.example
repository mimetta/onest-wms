# ---------------------------------------------------------------------------
# Onest WMS — environment variables
#
# Copy to .env.local and fill in. .env.local is gitignored and must never be
# committed. See PLAN.md §17.1 for where each Supabase value lives in the
# dashboard.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> Data API -> Project API keys -> anon / public
# Public by design. RLS is what protects the data behind it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> Data API -> Project API keys -> service_role / secret
# SERVER ONLY. Bypasses RLS entirely. Never prefix with NEXT_PUBLIC_ and never
# import into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> Database -> Connection string -> URI
# Contains the database password set at project creation. Used by the CLI.
SUPABASE_DB_URL=

# Project Settings -> General -> Reference ID. Used by `supabase link`.
SUPABASE_PROJECT_REF=

# The database password chosen at project creation. Supabase shows it once;
# reset it on the Database settings page if lost.
SUPABASE_DB_PASSWORD=

# --- Local development ----------------------------------------------------
# `supabase start` prints these. They are the same on every machine and are
# not secret — the local stack is throwaway.
LOCAL_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- AccCloud ERP (inbound only; see PLAN.md §18) --------------------------
ACCCLOUD_API_BASE_URL=https://acccloud.me/api
ACCCLOUD_COMPANY_CODE=MMT2025
# Authentication scheme not yet confirmed by AccCloud. Placeholder.
ACCCLOUD_API_TOKEN=

# --- App ------------------------------------------------------------------
TZ=Asia/Bangkok
NEXT_PUBLIC_DEFAULT_LOCALE=th
